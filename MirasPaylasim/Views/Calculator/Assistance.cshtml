@{
    ViewData["Title"] = "Denkleştirme";
}
<div class="card wizard-card p-4">
    <div class="wizard-progress"><div class="bar" style="--progress: 96%"></div></div>
    <h4 class="mb-3">Miras Hesaplama - Denkleştirme</h4>
    <form asp-action="Assistance" method="post">
        <div class="mb-4">
            <label class="form-label fw-bold">Soru:</label>
            <p class="mb-3">Miras bırakan sağlığında mirasçılardan birine önemli bir mal veya para yardımı yaptı mı?</p>
            
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="hasAssistance" id="hasAssistanceYes" value="true" required />
                <label class="form-check-label" for="hasAssistanceYes">Evet</label>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="hasAssistance" id="hasAssistanceNo" value="false" />
                <label class="form-check-label" for="hasAssistanceNo">Hayır</label>
            </div>
            
            <small class="text-muted">"Evet" derse → Denkleştirme alt formu açılır.</small>
        </div>
        
        <div class="d-flex justify-content-between">
            <a href="@Url.Action("Back", new { currentStep = "Assistance" })" class="btn btn-secondary">← Geri</a>
            <button class="btn btn-success" type="submit">Devam</button>
        </div>
    </form>
</div>

