@{
    ViewData["Title"] = "Malvarlığı";
}
<div class="card wizard-card p-4">
    <div class="wizard-progress"><div class="bar" style="--progress: 90%"></div></div>
    <h4 class="mb-3">Miras Hesaplama - Malvarlığı</h4>
    <form asp-action="Estate" method="post">
        
        <div class="mb-3">
            <label class="form-label">Tahmini parasal malvarlığı (TL): (tahmini ev-arsa-tarla değeri, aracın değeri, bankadaki para)</label>
            <input class="form-control" type="number" name="totalAssets" step="0.01" min="0" value="0" required />
            <small class="form-text text-muted">(yoksa bu kısma <span style="color: red; font-weight: bold;">"0"</span> giriniz)</small>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Kira alacağı:</label>
            <input class="form-control" type="number" name="rentReceivable" step="0.01" min="0" value="0" required />
            <small class="form-text text-muted">(yoksa bu kısma <span style="color: red; font-weight: bold;">"0"</span> giriniz)</small>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Borç verdiği kişilerden olan alacaklar / alacaklar:</label>
            <input class="form-control" type="number" name="receivables" step="0.01" min="0" value="0" required />
            <small class="form-text text-muted">(yoksa bu kısma <span style="color: red; font-weight: bold;">"0"</span> giriniz)</small>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Şirket hisseleri / ticari işletme malvarlığı / patent, marka, telif hakları:</label>
            <input class="form-control" type="number" name="companyShares" step="0.01" min="0" value="0" required />
            <small class="form-text text-muted">(yoksa bu kısma <span style="color: red; font-weight: bold;">"0"</span> giriniz)</small>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Yaptırılan sigortadan faydalanacak kişi atanmamışsa sigorta tazminatı:</label>
            <input class="form-control" type="number" name="insuranceCompensation" step="0.01" min="0" value="0" required />
            <small class="form-text text-muted">(yoksa bu kısma <span style="color: red; font-weight: bold;">"0"</span> giriniz)</small>
        </div>
      
        
        <div class="d-flex justify-content-between">
            <a href="@Url.Action("Back", new { currentStep = "Estate" })" class="btn btn-secondary">← Geri</a>
            <button class="btn btn-success" type="submit">Devam</button>
        </div>
    </form>
</div>
