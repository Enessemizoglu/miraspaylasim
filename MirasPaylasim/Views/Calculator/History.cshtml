@using System.Linq
@{
    ViewData["Title"] = "Hesaplama Geçmişi";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
    var hasPreviousPage = ViewBag.HasPreviousPage as bool? ?? false;
    var hasNextPage = ViewBag.HasNextPage as bool? ?? false;
}
<div class="card wizard-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">Hesaplama Geçmişi</h4>
        <a href="@Url.Action("Start")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Hesaplama
        </a>
    </div>
    
    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-inbox" style="font-size: 3rem; color: #6c757d;"></i>
            <p class="mt-3 mb-0">Henüz hesaplama geçmişi bulunmamaktadır.</p>
            <a href="@Url.Action("Start")" class="btn btn-primary mt-3">İlk Hesaplamanı Yap</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Tarih</th>
                        <th>Toplam Malvarlığı</th>
                        <th>Borçlar</th>
                        <th>Net Tereke</th>
                        <th>Mirasçı Sayısı</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var calc in Model)
                    {
                        <tr>
                            <td>
                                <div>@calc.CreatedAt.ToString("dd.MM.yyyy")</div>
                                <small class="text-muted">@calc.CreatedAt.ToString("HH:mm")</small>
                            </td>
                            <td>@calc.TotalAssets.ToString("N2") TL</td>
                            <td>@calc.Debts.ToString("N2") TL</td>
                            <td><strong>@calc.NetEstate.ToString("N2") TL</strong></td>
                            <td>
                                <span class="badge bg-secondary">@calc.HeirCount mirasçı</span>
                            </td>
                            <td class="text-end">
                                <a href="@Url.Action("Result", new { id = calc.Id })" class="btn btn-sm btn-primary">
                                    <i class="bi bi-eye"></i> Görüntüle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav aria-label="Sayfalama">
                <ul class="pagination justify-content-center mt-4">
                    <!-- Önceki sayfa -->
                    <li class="page-item @(hasPreviousPage ? "" : "disabled")">
                        <a class="page-link" href="@Url.Action("History", new { page = currentPage - 1 })" aria-label="Önceki">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    
                    <!-- Sayfa numaraları -->
                    @{
                        var startPage = Math.Max(1, currentPage - 2);
                        var endPage = Math.Min(totalPages, currentPage + 2);
                    }
                    
                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("History", new { page = 1 })">1</a>
                        </li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                    }
                    
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("History", new { page = i })">@i</a>
                        </li>
                    }
                    
                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("History", new { page = totalPages })">@totalPages</a>
                        </li>
                    }
                    
                    <!-- Sonraki sayfa -->
                    <li class="page-item @(hasNextPage ? "" : "disabled")">
                        <a class="page-link" href="@Url.Action("History", new { page = currentPage + 1 })" aria-label="Sonraki">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        }
        
        <div class="mt-3 text-muted small text-center">
            Toplam @totalCount hesaplama bulundu - Sayfa @currentPage / @totalPages
        </div>
    }
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

