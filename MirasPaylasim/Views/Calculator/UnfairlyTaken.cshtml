@{
    ViewData["Title"] = "Terekenin İadesi";
}
<div class="card wizard-card p-4">
    <div class="wizard-progress"><div class="bar" style="--progress: 98%"></div></div>
    <h4 class="mb-3">Miras Hesaplama - Terekenin İadesi</h4>
    <form asp-action="UnfairlyTaken" method="post">
        <div class="mb-4">
            <p class="mb-3">Miras bırakanın ölümünden önce haksız şekilde alınmış, gizlenmiş veya kaçırılmış bir mal var mı?</p>
            
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="hasUnfairlyTaken" id="hasUnfairlyTakenYes" value="true" required />
                <label class="form-check-label" for="hasUnfairlyTakenYes">Evet</label>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="hasUnfairlyTaken" id="hasUnfairlyTakenNo" value="false" />
                <label class="form-check-label" for="hasUnfairlyTakenNo">Hayır</label>
            </div>
            
            <small class="text-muted">"Evet" → Terekenin iadesi alt formu açılır.</small>
        </div>
        
        <div class="d-flex justify-content-between">
            <a href="@Url.Action("Back", new { currentStep = "UnfairlyTaken" })" class="btn btn-secondary">← Geri</a>
            <button class="btn btn-success" type="submit">Devam</button>
        </div>
    </form>
</div>

